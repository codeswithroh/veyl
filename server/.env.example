# Copy to .env.local (or export directly) — never commit real values.

# sepolia (default, per the testnet-before-mainnet rule) or mainnet — only flip
# to mainnet once the Sepolia path has been fully verified end-to-end.
VEYL_NETWORK=sepolia

# The viewing key this service uses to run shadow accounts. The single highest-value
# secret in Veyl — a secrets manager in production, not a laptop .env. Loss or
# compromise deanonymizes every shadow account this service manages.
VEYL_BACKEND_VIEWING_KEY=

# A normal Starknet account this service uses to sign proof invocations — distinct
# from the viewing key above.
VEYL_SERVICE_ACCOUNT_ADDRESS=
VEYL_SERVICE_ACCOUNT_PRIVATE_KEY=

# Address of the deployed ShadowAccountAnonymizer instance on VEYL_NETWORK. Empty
# until that deployment is explicitly approved and run — see
# ../STRK20_INTEGRATION_PLAN.md Phase 2. Deploy to Sepolia first, verify, then
# (separately, explicitly) deploy to mainnet.
SHADOW_ACCOUNT_ANONYMIZER_ADDRESS=

# Same Alchemy Starknet RPC key as the frontend's NEXT_PUBLIC_PROVIDER_URL.
ALCHEMY_KEY=

# Required, no working default — there is no shared public STRK20 prover/discovery
# service. Self-host the Transaction Prover and Discovery Service (Docker images
# in the Privacy SDK monorepo's README) and point these at your own deployment.
VEYL_PROVING_SERVICE_URL=
VEYL_DISCOVERY_SERVICE_URL=

PORT=8787
